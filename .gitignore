# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# keep example files so forkers have a template to copy
!.env.local.example
!.env.example

# vercel
.vercel

# worktrees isolados por feature
/.worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# `public/` é servida publicamente pelo Next.js — planilha de contatos
# (nome/telefone reais) já apareceu solta aqui por engano mais de uma
# vez. Nunca deve ir pra lá; a importação lê o arquivo pelo seletor do
# navegador, não precisa dele dentro do projeto.
public/*.xlsx
public/*.xls
public/*.csv
public/~$*

# grafo gerado pelo graphify (local, regeneravel)
/graphify-out/

# config local do Claude Code: a allowlist de permissoes grava o
# comando literal aprovado, e algum comando passado ja levou token/
# segredo embutido na string (ex.: curl com "Authorization: Bearer
# sbp_...") - achado por engano num commit em 27/10/2026, antes de
# chegar no remoto. Nunca versionar.
.claude/settings.json
.claude/settings.json.graphify-bak
.claude/settings.local.json
.claude/worktrees/
